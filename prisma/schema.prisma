generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  name      String?
  email     String?
  phone     String?
  role      String    @default("customer")
  createdAt DateTime  @default(now())
  orders    Order[]
  bookings  Booking[]
}

model Expert {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  specialty   String
  photo       String    @default("")
  bio         String    @db.Text
  credentials String[]
  rating      Float     @default(5)
  reviewCount Int       @default(0)
  calLink     String    @default("")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[] @relation("ExpertRecommends")
  bookings    Booking[]
}

model Product {
  id                 String      @id @default(cuid())
  slug               String      @unique
  sku                String      @unique
  name               String
  description        String      @db.Text
  price              Int // in rupees (whole number)
  images             String[]
  stock              Int         @default(0)
  category           String
  consultRecommended Boolean     @default(false)
  featured           Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  experts            Expert[]    @relation("ExpertRecommends")
  orderItems         OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
  total             Int // in rupees
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED
  fulfillmentStatus String      @default("PROCESSING") // PROCESSING | SHIPPED | DELIVERED | CANCELLED
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  shipName          String
  shipPhone         String
  shipEmail         String
  shipAddress1      String
  shipAddress2      String      @default("")
  shipCity          String
  shipState         String
  shipPincode       String
  createdAt         DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int // unit price in rupees at time of purchase
  quantity  Int
}

model Booking {
  id            String    @id @default(cuid())
  calUid        String?   @unique
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  expertId      String?
  expert        Expert?   @relation(fields: [expertId], references: [id])
  expertName    String    @default("")
  title         String
  startTime     DateTime
  endTime       DateTime?
  status        String    @default("CONFIRMED") // CONFIRMED | CANCELLED | COMPLETED
  attendeeName  String    @default("")
  attendeeEmail String    @default("")
  attendeePhone String    @default("")
  createdAt     DateTime  @default(now())
}
