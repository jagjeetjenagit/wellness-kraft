generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  name      String?
  email     String?
  phone     String?
  role      String    @default("customer")
  createdAt DateTime  @default(now())
  orders    Order[]
  bookings  Booking[]
}

model Expert {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  specialty   String
  photo       String    @default("")
  bio         String    @db.Text
  credentials String[]
  rating      Float     @default(5)
  reviewCount Int       @default(0)
  fee         Int       @default(0) // 1-on-1 consultation fee in rupees; 0 = no online payment
  calLink     String    @default("")
  featured    Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  // Expert self-service portal: the Google email they log in with.
  email       String    @default("")
  // Bookable availability (used by the native slot engine).
  availDays   String    @default("1,2,3,4,5,6") // weekday numbers, 0=Sun..6=Sat
  startHour   Int       @default(10) // first slot hour (IST)
  endHour     Int       @default(18) // last slot starts before this hour (IST)
  slotMins    Int       @default(30)
  products    Product[] @relation("ExpertRecommends")
  bookings    Booking[]
}

model Product {
  id                 String      @id @default(cuid())
  slug               String      @unique
  sku                String      @unique
  name               String
  description        String      @db.Text
  price              Int // in rupees (whole number)
  images             String[]
  stock              Int         @default(0)
  category           String
  consultRecommended Boolean     @default(false)
  featured           Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  experts            Expert[]    @relation("ExpertRecommends")
  orderItems         OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
  total             Int // in rupees
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED
  fulfillmentStatus String      @default("PROCESSING") // PROCESSING | SHIPPED | DELIVERED | CANCELLED
  razorpayOrderId   String      @unique
  razorpayPaymentId String?
  shipName          String
  shipPhone         String
  shipEmail         String
  shipAddress1      String
  shipAddress2      String      @default("")
  shipCity          String
  shipState         String
  shipPincode       String
  createdAt         DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int // unit price in rupees at time of purchase
  quantity  Int
}

model Booking {
  id                String    @id @default(cuid())
  calUid            String?   @unique
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])
  expertId          String?
  expert            Expert?   @relation(fields: [expertId], references: [id])
  expertName        String    @default("")
  title             String
  startTime         DateTime
  endTime           DateTime?
  status            String    @default("CONFIRMED") // CONFIRMED | CANCELLED | COMPLETED
  attendeeName      String    @default("")
  attendeeEmail     String    @default("")
  attendeePhone     String    @default("")
  amountPaid        Int       @default(0) // consultation fee paid online, in rupees
  razorpayPaymentId String    @default("")
  prescription      String    @default("") @db.Text // expert's advice/prescription, shown in the customer dashboard
  prescribedProductIds String[] @default([]) // products the expert recommends (Buy buttons in the dashboard)
  // Reminder emails already sent for this booking (so the cron never repeats one).
  remind30Sent      Boolean   @default(false) // 30-minutes-before reminder (no link)
  remind10Sent      Boolean   @default(false) // 10-minutes-before reminder (includes the join link)
  createdAt         DateTime  @default(now())
}

// Customer testimonials shown on the home page, managed from /admin.
// Each can be a written quote and/or a portrait (9:16) video clip.
model Testimonial {
  id        String   @id @default(cuid())
  name      String // customer's name (or initials)
  location  String   @default("") // optional: city, or their goal/condition
  quote     String   @db.Text // the written testimonial / caption
  rating    Int      @default(5) // 1–5 stars
  photo     String   @default("") // optional square headshot / video poster
  videoUrl  String   @default("") // optional 9:16 testimonial video (mp4/webm URL)
  featured  Boolean  @default(true) // show on the home page
  active    Boolean  @default(true) // visible at all
  sortOrder Int      @default(0) // lower shows first
  createdAt DateTime @default(now())
}

// Site-wide SEO / metadata, editable by the admin. A single row (id = 1).
// The public <head> reads this; when the row or DB is missing, the code
// falls back to the built-in defaults so SEO always has sensible values.
model SiteSetting {
  id              Int      @id @default(1)
  metaTitle       String   @default("") // browser tab + search result title (site default)
  metaDescription String   @default("") @db.Text // search result snippet
  keywords        String   @default("") @db.Text // comma-separated SEO keywords
  ogImage         String   @default("") // social share image URL (Open Graph / Twitter)
  updatedAt       DateTime @updatedAt
}

// Online payment collected for a consultation (before the Cal.com slot
// is picked). Linked to the Booking afterwards via the Cal webhook,
// matched on the customer's email.
model ConsultPayment {
  id                String   @id @default(cuid())
  razorpayOrderId   String   @unique
  razorpayPaymentId String   @default("")
  status            String   @default("PENDING") // PENDING | PAID | FAILED
  amount            Int // rupees
  expertId          String?
  expertName        String   @default("General Consultation")
  customerName      String   @default("")
  customerEmail     String   @default("")
  customerPhone     String   @default("")
  bookingId         String? // set once matched to a Booking
  // "Pick your slot" nudge sent (5 min after payment, only if still unbooked).
  slotNudgeSent     Boolean  @default(false)
  createdAt         DateTime @default(now())
}
