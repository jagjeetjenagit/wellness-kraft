# ============================================================
#  COPY THIS FILE to a new file named exactly:  .env
#  Then fill in each value below. The README walks you through
#  getting every single key, step by step.
#
#  The site RUNS even with everything empty (demo mode), but
#  login, database, payments and email only work once filled.
# ============================================================


# ------------------------------------------------------------
# 1) DATABASE — Neon Postgres (free)
# Where: https://neon.tech -> sign up -> create project ->
#        click "Connect" -> copy the "Connection string"
#        (choose "Pooled connection" if offered)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# ------------------------------------------------------------
DATABASE_URL=""


# ------------------------------------------------------------
# 2) LOGIN — Google sign-in (Auth.js, free)
# Where: https://console.cloud.google.com -> APIs & Services ->
#        Credentials -> Create OAuth client ID -> "Web application".
# Authorized redirect URI to paste there (dev):
#        http://localhost:3000/api/auth/callback/google
# Then copy the Client ID and Client secret below.
# AUTH_SECRET is any long random string. Generate one with:
#        node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ------------------------------------------------------------
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# On Vercel / a custom domain, also set these (see README step 7):
# AUTH_URL="https://your-domain.com"
# AUTH_TRUST_HOST="true"

# Who is allowed into the /admin area?
# Type the Google email address(es) you sign in with, separated by
# commas. Example: "owner@gmail.com,staff@gmail.com"
ADMIN_EMAILS=""

# ------------------------------------------------------------
# 2b) IMAGE UPLOADS — Vercel Blob (free)
# Lets you drag-and-drop & crop product/expert photos in /admin.
# Where: Vercel dashboard -> your project -> Storage -> Create a
#        database -> Blob -> Connect. Then open the store and copy
#        its BLOB_READ_WRITE_TOKEN here (also add it in Vercel).
# Without it, the admin image picker lets you paste a link instead.
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""


# ------------------------------------------------------------
# 3) PAYMENTS — Razorpay
# Where: https://dashboard.razorpay.com -> Account & Settings ->
#        API Keys -> Generate Key
# Key Id starts with rzp_test_ (test mode) or rzp_live_
# Use TEST keys first; switch to LIVE keys when going live.
# ------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


# ------------------------------------------------------------
# 4) EMAIL — Resend (free)
# Where: https://resend.com -> sign up -> API Keys -> Create
# Key starts with re_
# ------------------------------------------------------------
RESEND_API_KEY=""

# The "from" address on emails. On the free plan without your
# own domain, keep this exactly as: onboarding@resend.dev
EMAIL_FROM="onboarding@resend.dev"

# Where should ORDER NOTIFICATIONS and contact-form messages go?
# Your own email address:
ADMIN_NOTIFY_EMAIL=""


# ------------------------------------------------------------
# 5) BOOKINGS — Cal.com (free)
# No key needed here! Each expert's Cal.com link (for example
# "priya-sharma/consultation") is entered in the Admin area.
# Optional: a webhook secret so booking history shows on the
# site. See README "Cal.com" section. Any random long text.
# ------------------------------------------------------------
CAL_WEBHOOK_SECRET=""

# GENERAL CONSULTATION (the "Not sure who to pick?" option)
# Fee in rupees (whole number). Leave as is or change the price.
NEXT_PUBLIC_GENERAL_CONSULT_FEE="499"
# The Cal.com link for the shared/general calendar — only the part
# after cal.com/ (e.g. "wellness-kraft/general"). Until you set
# this, the General Consultation page shows a contact fallback.
NEXT_PUBLIC_GENERAL_CAL_LINK=""


# ------------------------------------------------------------
# 6) WEBSITE ADDRESS — used for SEO / sitemap / links in emails
# Locally keep as is. After deploying, change to your real
# Vercel address, e.g. https://your-site.vercel.app
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ------------------------------------------------------------
# 7) ANALYTICS (optional — leave empty if not using yet)
# GA4: https://analytics.google.com -> Admin -> Data streams ->
#      copy the "Measurement ID" (starts with G-)
# GTM: https://tagmanager.google.com -> container ID (GTM-XXXX)
# ------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
